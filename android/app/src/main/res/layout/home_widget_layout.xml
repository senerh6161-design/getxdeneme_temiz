<?xml version="1.0" encoding="utf-8"?>
<!--
    Bu, ana ekrandaki (home screen) widget'ın GÖRÜNÜMÜ. Normal bir Flutter
    widget'ı değil, saf Android XML — çünkü ana ekran widget'ları Flutter'ın
    dışında, Android'in kendi çizim sistemiyle (RemoteViews) gösteriliyor.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@drawable/home_widget_background"
    android:padding="12dp">

    <TextView
        android:id="@+id/widget_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0"
        android:textSize="32sp"
        android:textStyle="bold"
        android:textColor="#1976D2" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="İşe Gidilen Gün"
        android:textSize="12sp"
        android:textColor="#616161"
        android:layout_marginTop="4dp" />

</LinearLayout>
